---
import { Image } from 'astro:assets';
const { project } = Astro.props;
---
<a href={`/projects/${project.id}`} class="block rounded-xl overflow-hidden shadow-sm hover:shadow-md transition relative">
  {project.data.award && (
    <span class="absolute top-3 right-3 z-10 flex items-center gap-1 bg-amber-100 text-amber-800 text-xs font-semibold px-2.5 py-1 rounded-full border border-amber-200">
      <span class="material-symbols-outlined2">emoji_events</span>
      {project.data.award}
    </span>
  )}

  <Image src={project.data.cover} alt={project.data.title} class="w-full h-48 object-cover" />
  <div class="p-4">
    <h3 class="font-semibold text-2xl">{project.data.title}</h3>
    <p class="text-md text-gray-500 mb-3">{project.data.description}</p>

    {project.data.skills && project.data.skills.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {project.data.skills.map((skill: string) => (
          <span class="text-sm px-2 py-0.5 border border-gray-200 text-gray-600">
            {skill}
          </span>
        ))}
      </div>
    )}
  </div>
</a>