---
// src/components/Sidebar.astro
import { getCollection } from "astro:content";
const projects = await getCollection("projects");
const currentPath = Astro.url.pathname;
---

<aside
  class="w-64 h-screen fixed left-0 top-0 bg-black text-white flex flex-col p-6"
>
  <a href="/" class="flex items-end gap-2 text-3xl font-semibold mb-8">
    <span class="material-symbols-outlined text-3xl mb-0.75">home</span>
    Home
  </a>

  <nav class="flex flex-col gap-1 text-xl">
    <a
      href="/about"
      class={`flex items-center gap-2 px-3 py-2 rounded-md transition ${
        currentPath === "/about"
          ? "bg-white text-gray-900"
          : "text-gray-300 hover:bg-white/10 hover:text-white"
      }`}
    >
      <span class="material-symbols-outlined text-xs mb-1">person_celebrate</span>
      About Me
    </a>

    <div class="flex flex-col gap-1">
      <div
        class={`flex items-center justify-between rounded-md transition ${
          currentPath === "/projects"
            ? "bg-white text-gray-900"
            : "text-gray-300 hover:bg-white/10 hover:text-white"
        }`}
      >
        <a href="/projects" id="projects-link" class="flex items-center gap-2 flex-1 px-3 py-2">
          <span class="material-symbols-outlined text-lg" id="folder-icon-closed">folder</span>
          <span class="material-symbols-outlined text-lg !hidden" id="folder-icon-open">folder_open</span>
          Projects
        </a>
        <button
          type="button"
          id="projects-toggle"
          aria-expanded="false"
          aria-label="Toggle projects list"
          class="px-3 py-2 rounded-md hover:bg-white/10 transition"
        >
          <span id="projects-arrow" class="inline-block transition-transform text-3xl leading-none">›</span>
        </button>
      </div>

      <div
        id="projects-list"
        class="hidden ml-3 mt-1 flex flex-col gap-1 border-l border-white/20 pl-3"
      >
        {
          projects.map((project) => {
            const href = `/projects/${project.id}`;
            return (
              <a
                href={href}
                class={`px-3 py-1.5 rounded-md transition ${
                  currentPath === href
                    ? "bg-white text-gray-900"
                    : "text-gray-400 hover:bg-white/10 hover:text-white"
                }`}
              >
                {project.data.title}
              </a>
            );
          })
        }
      </div>
    </div>

    <a
      href="/contact"
      class={`flex items-center gap-2 px-3 py-2 rounded-md transition ${
        currentPath === "/contact"
          ? "bg-white text-gray-900"
          : "text-gray-300 hover:bg-white/10 hover:text-white"
      }`}
    >
      <span class="material-symbols-outlined text-lg">mail</span>
      Contact
    </a>
  </nav>

  <div
    class="mt-auto flex gap-4 text-gray-400 text-sm pt-6 border-t border-white/10"
  >
    <a
      href="https://github.com/yourusername"
      target="_blank"
      class="hover:text-white transition"
    >
      GitHub
    </a>
    <a
      href="https://linkedin.com/in/yourusername"
      target="_blank"
      class="hover:text-white transition"
    >
      LinkedIn
    </a>
  </div>
</aside>

<script>
  const toggleBtn = document.getElementById("projects-toggle");
  const projectsLink = document.getElementById("projects-link");
  const list = document.getElementById("projects-list");
  const arrow = document.getElementById("projects-arrow");
  const folderClosed = document.getElementById("folder-icon-closed");
  const folderOpen = document.getElementById("folder-icon-open");

  function toggleProjectsDropdown() {
    const isNowHidden = list?.classList.toggle("hidden");
    const isOpen = !isNowHidden;

    toggleBtn?.setAttribute("aria-expanded", String(isOpen));
    if (arrow) arrow.style.transform = isOpen ? "rotate(90deg)" : "rotate(0deg)";
    folderClosed?.classList.toggle("!hidden", isOpen);
    folderOpen?.classList.toggle("!hidden", !isOpen);
  }

  toggleBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    toggleProjectsDropdown();
  });

  // Clicking the Projects link itself also opens the dropdown, then navigates as normal
  projectsLink?.addEventListener("click", () => {
    if (list?.classList.contains("hidden")) {
      toggleProjectsDropdown();
    }
  });
</script>