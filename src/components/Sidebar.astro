---
// src/components/Sidebar.astro
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
---
<aside class="w-64 h-screen fixed left-0 top-0 border-r border-gray-200 bg-white flex flex-col p-6">
  <a href="/" class="text-lg font-semibold mb-8">Home</a>
  <nav class="flex flex-col gap-1 text-sm">
    <a href="/about" class="px-3 py-2 rounded-md hover:bg-gray-100 transition">
      About Me
    </a>
    <details class="group">
      <summary class="px-3 py-2 rounded-md hover:bg-gray-100 transition cursor-pointer list-none flex items-center justify-between">
        Projects
        <span class="transition-transform group-open:rotate-90">›</span>
      </summary>
      <div class="ml-3 mt-1 flex flex-col gap-1 border-l border-gray-200 pl-3">
        {projects.map(project => (
          <a
            href={`/projects/${project.id}`}
            class="px-3 py-1.5 rounded-md hover:bg-gray-100 transition text-gray-600"
          >
            {project.data.title}
          </a>
        ))}
      </div>
    </details>
    <a href="/contact" class="px-3 py-2 rounded-md hover:bg-gray-100 transition">
      Contact
    </a>
  </nav>
</aside>