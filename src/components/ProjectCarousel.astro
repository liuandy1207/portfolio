---
// src/components/ProjectCarousel.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type CarouselItem =
  | { type: 'image'; image: ImageMetadata; caption?: string }
  | { type: 'video'; src: string; poster?: ImageMetadata; caption?: string };

interface Props {
  images: CarouselItem[];
  alt: string;
}

const { images, alt } = Astro.props as Props;
---

<div class="carousel relative w-full" data-carousel>
  <div class="carousel-track-wrapper overflow-hidden rounded-xl">
    <div class="carousel-track flex items-start transition-transform duration-300 ease-out" data-track>
    {images.map((item: CarouselItem, index: number) => (
        <div class="carousel-slide shrink-0 w-full mr-0">
        {item.type === 'video' ? (
            <video
              src={item.src}
              poster={item.poster?.src}
              controls
              playsinline
              class="w-full rounded-xl shadow-sm bg-black"
              data-carousel-video
            >
              Your browser doesn't support embedded video.
            </video>
        ) : (
            <Image
              src={item.image}
              alt={item.caption || `${alt} image ${index + 1}`}
              class="w-full object-cover rounded-xl shadow-sm"
            />
        )}
        {item.caption && (
            <p class="text-md mt-2 text-center">{item.caption}</p>
        )}
        </div>
    ))}
    </div>
  </div>

  {images.length > 1 && (
    <>
      <button
        type="button"
        class="carousel-prev absolute left-2 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white shadow-md rounded-full w-9 h-9 flex items-center justify-center transition"
        aria-label="Previous item"
      >
        <span class="material-symbols-outlined text-lg">chevron_left</span>
      </button>
      <button
        type="button"
        class="carousel-next absolute right-2 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white shadow-md rounded-full w-9 h-9 flex items-center justify-center transition"
        aria-label="Next item"
      >
        <span class="material-symbols-outlined text-lg">chevron_right</span>
      </button>

      <div class="carousel-dots flex justify-center gap-2 mt-4">
        {images.map((_: CarouselItem, index: number) => (
          <button
            type="button"
            class="carousel-dot w-2 h-2 rounded-full bg-gray-300 transition"
            data-dot-index={index}
            aria-label={`Go to item ${index + 1}`}
          ></button>
        ))}
      </div>
    </>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-track]');
    const slides = carousel.querySelectorAll<HTMLElement>('.carousel-slide');
    const prevBtn = carousel.querySelector<HTMLButtonElement>('.carousel-prev');
    const nextBtn = carousel.querySelector<HTMLButtonElement>('.carousel-next');
    const dots = carousel.querySelectorAll<HTMLButtonElement>('.carousel-dot');

    if (!track || slides.length === 0) return;

    let currentIndex = 0;
    const total = slides.length;

    function getSlideOffset(): number {
      const slide = slides[0];
      const style = window.getComputedStyle(slide);
      const marginRight = parseFloat(style.marginRight) || 0;
      return slide.getBoundingClientRect().width + marginRight;
    }

    // Pause and rewind any video that isn't on the active slide, so audio/
    // playback doesn't keep running once the user scrolls past it.
    function pauseInactiveVideos(): void {
      slides.forEach((slide, i) => {
        const video = slide.querySelector<HTMLVideoElement>('[data-carousel-video]');
        if (video && i !== currentIndex) {
          video.pause();
          video.currentTime = 0;
        }
      });
    }

    function updateCarousel(): void {
      const offset = getSlideOffset();
      track!.style.transform = `translateX(-${offset * currentIndex}px)`;

      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-gray-900', i === currentIndex);
        dot.classList.toggle('bg-gray-300', i !== currentIndex);
      });

      pauseInactiveVideos();
    }

    function goNext(): void {
      currentIndex = (currentIndex + 1) % total; // loops back to 0
      updateCarousel();
    }

    function goPrev(): void {
      currentIndex = (currentIndex - 1 + total) % total; // loops to last
      updateCarousel();
    }

    nextBtn?.addEventListener('click', goNext);
    prevBtn?.addEventListener('click', goPrev);

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const dotIndex = dot.getAttribute('data-dot-index');
        if (dotIndex !== null) {
          currentIndex = parseInt(dotIndex, 10);
          updateCarousel();
        }
      });
    });

    window.addEventListener('resize', updateCarousel);
    updateCarousel();
  });
</script>