---
// src/components/ProjectCarousel.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getYouTubeEmbedUrl } from '../utils/youtube';

type CarouselItem =
  | { type: 'image'; image: ImageMetadata; caption?: string }
  | { type: 'video'; src: string; poster?: ImageMetadata; caption?: string }
  | { type: 'youtube'; url: string; caption?: string };

interface Props {
  images: CarouselItem[];
  alt: string;
}

const { images, alt } = Astro.props as Props;
---

<div class="carousel relative w-full" data-carousel>
  <div class="carousel-track-wrapper overflow-hidden rounded-xl transition-[height] duration-300 ease-out will-change-[height]" data-track-wrapper>
    <div class="carousel-track flex items-start transition-transform duration-300 ease-out" data-track>
    {images.map((item: CarouselItem, index: number) => (
        <div class="carousel-slide shrink-0 w-full mr-0">
        {item.type === 'video' ? (
            <video
              src={item.src}
              poster={item.poster?.src}
              controls
              playsinline
              class="block max-h-[650px] w-auto max-w-full mx-auto rounded-xl shadow-sm bg-black"
              data-carousel-video
              data-carousel-media
            >
              Your browser doesn't support embedded video.
            </video>
        ) : item.type === 'youtube' ? (
            (() => {
              const embedUrl = getYouTubeEmbedUrl(item.url);
              return embedUrl ? (
                <div class="aspect-video w-full max-w-[850px] mx-auto rounded-xl shadow-sm overflow-hidden bg-black">
                  <iframe
                    src={embedUrl}
                    title={item.caption || `${alt} video ${index + 1}`}
                    class="w-full h-full"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    data-carousel-iframe
                    data-src={embedUrl}
                    data-carousel-media
                  />
                </div>
              ) : (
                <p class="text-center text-red-500 py-8">Couldn't parse YouTube URL: {item.url}</p>
              );
            })()
        ) : (
            <Image
              src={item.image}
              alt={item.caption || `${alt} image ${index + 1}`}
              class="block max-h-[500px] w-auto max-w-full mx-auto object-contain rounded-xl shadow-sm"
              data-carousel-media
            />
        )}
        {item.caption && (
            <p class="text-md mt-2 text-center">{item.caption}</p>
        )}
        </div>
    ))}
    </div>
  </div>

  {images.length > 1 && (
    <>
      <button
        type="button"
        class="carousel-prev absolute left-2 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white shadow-md rounded-full w-9 h-9 flex items-center justify-center transition"
        aria-label="Previous item"
      >
        <span class="material-symbols-outlined text-lg">chevron_left</span>
      </button>
      <button
        type="button"
        class="carousel-next absolute right-2 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white shadow-md rounded-full w-9 h-9 flex items-center justify-center transition"
        aria-label="Next item"
      >
        <span class="material-symbols-outlined text-lg">chevron_right</span>
      </button>

      <div class="carousel-dots flex justify-center gap-2 mt-4">
        {images.map((_: CarouselItem, index: number) => (
          <button
            type="button"
            class="carousel-dot w-2 h-2 rounded-full bg-gray-300 transition"
            data-dot-index={index}
            aria-label={`Go to item ${index + 1}`}
          ></button>
        ))}
      </div>
    </>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const wrapper = carousel.querySelector<HTMLElement>('[data-track-wrapper]');
    const track = carousel.querySelector<HTMLElement>('[data-track]');
    const slides = carousel.querySelectorAll<HTMLElement>('.carousel-slide');
    const prevBtn = carousel.querySelector<HTMLButtonElement>('.carousel-prev');
    const nextBtn = carousel.querySelector<HTMLButtonElement>('.carousel-next');
    const dots = carousel.querySelectorAll<HTMLButtonElement>('.carousel-dot');

    if (!track || !wrapper || slides.length === 0) return;

    let currentIndex = 0;
    const total = slides.length;

    function getSlideOffset(): number {
      const slide = slides[0];
      const style = window.getComputedStyle(slide);
      const marginRight = parseFloat(style.marginRight) || 0;
      return slide.getBoundingClientRect().width + marginRight;
    }

    // Size the wrapper to just the active slide's content (including its
    // caption), instead of letting the row's tallest slide dictate height
    // for every slide.
    function updateWrapperHeight(): void {
      const activeSlide = slides[currentIndex];
      if (activeSlide) {
        wrapper!.style.height = `${activeSlide.offsetHeight}px`;
      }
    }

    // Stop playback on any slide that isn't active: pause+rewind native
    // videos, and reload YouTube iframes (there's no direct way to "pause"
    // an embed without the postMessage API, so reloading its src stops it).
    function pauseInactiveMedia(): void {
      slides.forEach((slide, i) => {
        if (i === currentIndex) return;

        const video = slide.querySelector<HTMLVideoElement>('[data-carousel-video]');
        if (video) {
          video.pause();
          video.currentTime = 0;
        }

        const iframe = slide.querySelector<HTMLIFrameElement>('[data-carousel-iframe]');
        if (iframe && iframe.dataset.src) {
          iframe.src = iframe.dataset.src; // reassigning stops playback
        }
      });
    }

    function updateCarousel(): void {
      // Reads first — batching these avoids a forced synchronous layout
      // that would otherwise happen if we read offsetHeight right after
      // writing the transform above it.
      const offset = getSlideOffset();
      const activeSlide = slides[currentIndex];
      const activeHeight = activeSlide?.offsetHeight;

      // Writes
      track!.style.transform = `translateX(-${offset * currentIndex}px)`;
      if (activeHeight !== undefined) {
        wrapper!.style.height = `${activeHeight}px`;
      }

      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-gray-900', i === currentIndex);
        dot.classList.toggle('bg-gray-300', i !== currentIndex);
      });

      pauseInactiveMedia();
    }

    function goNext(): void {
      currentIndex = (currentIndex + 1) % total; // loops back to 0
      updateCarousel();
    }

    function goPrev(): void {
      currentIndex = (currentIndex - 1 + total) % total; // loops to last
      updateCarousel();
    }

    nextBtn?.addEventListener('click', goNext);
    prevBtn?.addEventListener('click', goPrev);

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const dotIndex = dot.getAttribute('data-dot-index');
        if (dotIndex !== null) {
          currentIndex = parseInt(dotIndex, 10);
          updateCarousel();
        }
      });
    });

    // Recalculate height once media actually loads: images already have
    // explicit width/height from Astro so their layout is stable up front,
    // but videos and iframes may only settle their box size after metadata
    // or content loads.
    carousel.querySelectorAll<HTMLElement>('[data-carousel-media]').forEach((el) => {
      el.addEventListener('load', updateWrapperHeight);
      el.addEventListener('loadedmetadata', updateWrapperHeight);
    });

    window.addEventListener('resize', updateCarousel);
    updateCarousel();
  });
</script>