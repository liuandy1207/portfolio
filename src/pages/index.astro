---
// src/pages/index.astro
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = await getCollection("projects");
const featuredProjects = projects.filter(project => project.data.featured).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Home" showResumeButton={false}>
  <h1 class="text-5xl font-extrabold mb-6 -mt-4">
    Hello! I'm <a href= "/about" class="text-8xl hover:underline">Andy Liu</a>.
  </h1>

  <p class="text-3xl leading-relaxed">
    I'm an <a
      href="https://engsci.utoronto.ca/program/what-is-engsci/"
      target="_blank"
      ><strong class="font-semibold hover:underline">Engineering Science</strong
      ></a
    > student at the <strong class="font-semibold hover:text-[#1E3765]">
      University of Toronto</strong
    >, <br />
    majoring in <strong class="font-semibold"
      >Electrical and Computer Engineering</strong
    >.
  </p>

  <div class="flex justify-between">
  <a href= "/projects" class="text-8xl hover:underline"><h2 class="text-3xl font-semibold mb-4 mt-10">Featured Projects</h2></a>
  <a href="/projects" class="text-sm font-semibold text-gray-900 hover:underline mt-14">
    See all projects →
  </a>
</div>

  <div class="grid grid-cols-3 gap-6 not-prose">
    {featuredProjects.map((project) => <ProjectCard project={project} />)}
  </div>

  <div class="flex justify-center gap-4 mt-16 mb-4">
  
    <a
    href="/Andy-Liu-Resume.pdf"
    download
    class="bg-black text-white w-90 text-center py-4 rounded-lg font-semibold text-lg hover:bg-black/85 transition duration-100 shadow-sm"
  >
    Download Resume
  </a>

  <a
    href="mailto:liuandy1207@gmail.com"
    class="bg-black text-white w-90 text-center py-4 rounded-lg font-semibold text-lg hover:bg-black/85 transition duration-100 shadow-sm"
  >
    Contact Me
  </a>
</div>
</Layout>
